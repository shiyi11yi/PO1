
#!name=咕咕云防火墙自动加白
#!desc=支持网络切换、每5分钟定时上报、手动刷新及执行通知
#!category=Firewall
#!author=Eleven
#!arguments=tokens:""
#!arguments-desc=tokens: 填写 ctecsfw_xxx@2，多个Token使用英文逗号分隔

[Rule]
DOMAIN,www.guguyun.com,DIRECT

[Script]
guguyun-fw-cron = type=cron,cronexp="*/5 * * * *",wake-system=true,script-path=https://raw.githubusercontent.com/shiyi11yi/PO1/main/scripts/guguyun-firewall-whitelist.js,timeout=60,argument="source=cron&tokens={{{tokens}}}"

guguyun-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/shiyi11yi/PO1/main/scripts/guguyun-firewall-whitelist.js,timeout=60,argument="source=network&tokens={{{tokens}}}"

guguyun-fw-panel = type=generic,script-path=https://raw.githubusercontent.com/shiyi11yi/PO1/main/scripts/guguyun-firewall-whitelist.js,timeout=60,argument="source=panel&tokens={{{tokens}}}"

[Panel]
guguyun-fw = script-name=guguyun-fw-panel,title=咕咕云防火墙加白,content=点击刷新,update-interval=300
