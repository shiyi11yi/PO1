
#!name=咕咕云防火墙自动加白
#!desc=网络切换自动加白，官方固定槽位比对，支持多Token
#!category=Firewall
#!author=Eleven
#!arguments=tokens:""
#!arguments-desc=tokens: 填写带槽位的Token，例如ctecsfw_xxx@2，多个用英文逗号分隔

[Rule]
DOMAIN,www.guguyun.com,DIRECT
DOMAIN,ip.3322.net,DIRECT

[Script]
guguyun-fw-cron = type=cron,cronexp="*/5 * * * *",script-path=https://raw.githubusercontent.com/shiyi11yi/PO1/main/scripts/guguyun-firewall-whitelist.js,script-update-interval=300,timeout=45,argument="source=cron&tokens={{{tokens}}}"

guguyun-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/shiyi11yi/PO1/main/scripts/guguyun-firewall-whitelist.js,script-update-interval=300,timeout=45,argument="source=network&tokens={{{tokens}}}"

guguyun-fw-start = type=event,event-name=engine-started,script-path=https://raw.githubusercontent.com/shiyi11yi/PO1/main/scripts/guguyun-firewall-whitelist.js,script-update-interval=300,timeout=45,argument="source=start&tokens={{{tokens}}}"

guguyun-fw-panel = type=generic,script-path=https://raw.githubusercontent.com/shiyi11yi/PO1/main/scripts/guguyun-firewall-whitelist.js,script-update-interval=300,timeout=45,argument="source=panel&tokens={{{tokens}}}"

[Panel]
guguyun-fw = script-name=guguyun-fw-panel,title=咕咕云防火墙加白,content=点击刷新,update-interval=300
