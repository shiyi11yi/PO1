#!name=咕咕云防火墙自动加白
#!desc=调用咕咕云腾讯云 ECS 防火墙接口，将当前公网出口 IP 自动加入白名单。支持多个 token、网络变化自动触发、每 10 分钟定时刷新及手动刷新。
#!category=咕咕云
#!author=Eleven
#!arguments=tokens:""
#!arguments-desc=tokens: 咕咕云防火墙 token（ctecsfw_ 开头），多个 token 用英文逗号 , 分隔；token 后可直接带 @槽位，例如 ctecsfw_xxx@2

[Rule]
DOMAIN,www.guguyun.com,DIRECT

[Script]
guguyun-fw-cron = type=cron,cronexp="*/10 * * * *",script-path=https://raw.githubusercontent.com/shiyi11yi/PO1/main/scripts/guguyun-firewall-whitelist.js,timeout=30,argument="tokens={{{tokens}}}"

guguyun-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/shiyi11yi/PO1/main/scripts/guguyun-firewall-whitelist.js,timeout=30,argument="tokens={{{tokens}}}"

guguyun-fw-panel = type=generic,script-path=https://raw.githubusercontent.com/shiyi11yi/PO1/main/scripts/guguyun-firewall-whitelist.js,timeout=30,argument="tokens={{{tokens}}}"

[Panel]
guguyun-fw = script-name=guguyun-fw-panel,title=咕咕云防火墙加白,content=点击刷新,update-interval=300
